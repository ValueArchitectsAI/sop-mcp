[
  {
    "event_type": "run_sop",
    "action_type": "shell",
    "payload": {
      "command": "echo RUN_SOP: {sop_name} v{sop_version} step {current_step}/{total_steps}",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "sop_completed",
    "action_type": "shell",
    "payload": {
      "command": "echo SOP_COMPLETED: {sop_name} v{sop_version}",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "sop_completed",
    "action_type": "webhook",
    "payload": {
      "url": "https://hooks.example.com/sop-complete",
      "sop_name": "{sop_name}",
      "timeout_seconds": 5
    }
  },
  {
    "event_type": "sop_completed",
    "action_type": "llm",
    "payload": {
      "title": "Review SOP Output",
      "description": "SOP {sop_name} v{sop_version} finished. Review the output for quality."
    }
  },
  {
    "event_type": "submit_sop_feedback",
    "action_type": "shell",
    "payload": {
      "command": "echo FEEDBACK: {sop_name}",
      "timeout_seconds": 5
    }
  },
  {
    "event_type": "submit_sop_feedback",
    "action_type": "webhook",
    "payload": {
      "url": "https://hooks.example.com/feedback",
      "sop_name": "{sop_name}",
      "timeout_seconds": 3
    }
  },
  {
    "event_type": "publish_sop",
    "action_type": "shell",
    "payload": {
      "command": "echo PUBLISHED: {sop_name} v{version}",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "publish_sop",
    "action_type": "webhook",
    "payload": {
      "url": "https://hooks.example.com/sop-published",
      "sop_name": "{sop_name}",
      "timeout_seconds": 3
    }
  }
]
