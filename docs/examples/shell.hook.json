[
  {
    "event_type": "run_sop",
    "action_type": "shell",
    "payload": {
      "command": "echo RUN_SOP: {sop_name} v{sop_version} step {current_step}/{total_steps}",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "sop_completed",
    "action_type": "shell",
    "payload": {
      "command": "echo SOP_COMPLETED: {sop_name} v{sop_version} finished {total_steps} steps",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "publish_sop",
    "action_type": "shell",
    "payload": {
      "command": "echo PUBLISHED: {sop_name} v{version} ({change_type})",
      "timeout_seconds": 10
    }
  },
  {
    "event_type": "submit_sop_feedback",
    "action_type": "shell",
    "payload": {
      "command": "echo FEEDBACK: {sop_name} v{sop_version} at {timestamp}",
      "timeout_seconds": 8
    }
  }
]
